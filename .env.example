# LLM provider
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=6000
LLM_SOURCE_MAX_CHARS=0
LLM_SEED=42

# If you use an OpenAI-compatible router instead, override LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.

# Playwright MCP
# stdio + npx stay the transport. Do not add --headless if the browser window
# should appear. On Linux, Playwright MCP forces headless when the child has
# no DISPLAY; the app forwards DISPLAY and PLAYWRIGHT_MCP_* into that child.
# PLAYWRIGHT_MCP_HEADLESS=true hides the window on purpose.
MCP_MODE=stdio
MCP_COMMAND=npx
MCP_ARGS=["@playwright/mcp@latest","--user-data-dir",".browser-profile"]
MCP_URL=http://127.0.0.1:8931/mcp
PLAYWRIGHT_USER_DATA_DIR=.browser-profile

LLM_CODEGEN_MAX_TOKENS=10000
LLM_CODEGEN_HTML_CHARS=120000
LLM_REPAIR_MAX_TOKENS=5000

LLM_DISCOVERY_MAX_ROUNDS=4
LLM_DISCOVERY_MAX_TOOL_CALLS=9
LLM_REPAIR_MAX_ROUNDS=2
LLM_REPAIR_MAX_TOOL_CALLS=4
LLM_CONFIDENCE_THRESHOLD=0.95

LLM_DISCOVERY_MAX_OUTPUT_CHARS=32000
LLM_REPAIR_MAX_OUTPUT_CHARS=16000

# DeepSeek thinking-mode compatibility
# auto = enable thinking only on official api.deepseek.com; enabled = force it; disabled = never enable it
LLM_THINKING_MODE=auto
LLM_REASONING_EFFORT=high
LLM_TERMINAL_MAX_TOKENS=8000
